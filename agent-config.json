{
  "$schema": "./agent-config.schema.json",
  "_about": "Condor agent runtime config, read like Albatross's agent.config.json. Edits apply on the next tick or turn; no restart. Check with: uv run python -m condor.agent_config",

  "model": "openrouter:nvidia/nemotron-3.5-super-vl:free",

  "maxSteps": 1000,

  "approvalPolicy": "always",
  "alwaysAllow": [],

  "thinking": {
    "effort": "high",
    "exclude": false
  },
  "maxOutputTokens": null,
  "tickTimeoutSec": 900,

  "budget": {
    "enabled": true,
    "appliesTo": "all",
    "dailyRequestCap": 1000,
    "reserveRequests": 50,
    "requestsPerMinute": 18,
    "perRunRequestCap": 100,
    "pacing": true,
    "assumedRequestsPerTick": 8
  }
}
