# ── Required ─────────────────────────────────────────
# Create a bot: https://t.me/BotFather
TELEGRAM_TOKEN=

# Get your ID: https://t.me/userinfobot
ADMIN_USER_ID=

# ── AI model (set by make setup / make pick-model) ───
# The model Condor thinks with by default. Overrides agents/condor/AGENT.md;
# a user's own /agent → Change LLM choice still wins at runtime.
# Examples: claude-code, claude-acp:opus, ollama:qwen3:32b, openrouter:z-ai/glm-4.6
# CONDOR_DEFAULT_AGENT=

# Needed only for an openrouter:* default (make pick-model can enter it for you)
# OPENROUTER_API_KEY=

# ── Hummingbot API (set by make setup) ───────────────
# DEPLOY_HUMMINGBOT_API=true

# ── Run mode (set by make setup / setup-environment.sh) ──
# "telegram": runs the Telegram bot (needs TELEGRAM_TOKEN/ADMIN_USER_ID above)
# plus the web dashboard. "local": dashboard only, no Telegram bot — the setup
# wizard picks this for you based on the answers you give it; only set it by
# hand if you're changing modes after the fact.
# CONDOR_MODE=telegram

# ── Market data: CoinGecko / GeckoTerminal (optional) ─
# Condor runs keyless by default on GeckoTerminal's public API. That tier is
# ~30 requests/minute PER IP, shared by every dashboard viewer, the DEX pool
# browser, the candle poll loop and the LP routines — which is why a filtered
# pool page walks only 3 upstream pages before giving up.
#
# A CoinGecko ANALYST key raises that to 500/min, and Condor spends the headroom
# on both a bigger request budget and a deeper pool-browser walk, so venue
# filters answer from a real scan instead of a fallback.
#
# Only these two setups are supported: no key, or an Analyst (or higher) key.
# A free CoinGecko Demo key carries the same ~30/min limit on the on-chain
# endpoints as no key at all, so it is not accepted — set one here and the paid
# host returns 401, which Condor logs before falling back to keyless.
# COINGECKO_API_KEY=

# ── Web Dashboard (optional) ─────────────────────────
# Full public URL for the dashboard (include port if needed).
# Used for Telegram /web links AND as the server bind port.
# Examples: http://myserver.com:8088, https://dashboard.example.com
# WEB_URL=http://localhost:8088

# ── Alpaca paper trading (optional) ──────────────────
# Read by the alpaca_etf_sweep routine. Paper keys only: they are generated at
# app.alpaca.markets under Paper Trading, are separate from live keys, and the
# client refuses the live host outright.
# ALPACA_API_KEY_ID=
# ALPACA_API_SECRET_KEY=

# Paper Markets rollout (disabled unless explicitly true). New equity API
# handlers must still authenticate and enforce account ownership/risk policy.
# Disabling these gates preserves paper account reads and order cancellation.
# EQUITY_MARKETS_ENABLED=false
# EQUITY_PAPER_TRADING_ENABLED=false
# Per-order ceiling the route enforces before ever calling Alpaca (not a
# full risk service — a floor under an otherwise-unbounded order). Applies
# even unset: the default is 10000.
# EQUITY_MAX_ORDER_NOTIONAL=10000
# Read-only external smoke test, opt-in only; leave unset in ordinary CI.
# RUN_ALPACA_PAPER_SMOKE=0

# ── US venue credential imports (optional) ───────────
# Public crypto market data needs none of these values. Hummingbot connector
# credentials are imported into its ENCRYPTED store, preferably through
# Dashboard → Settings → Keys. Alternatively fill one venue below and run
# `uv run python scripts/us_venues.py import --venue CONNECTOR` from condor/.
# Clear imported secrets afterwards. See docs/us-venue-connectivity.md.
# US/state/product eligibility must be checked with each venue; this is not
# a legal allowlist. Mainnet rows can control real accounts: import/status
# never places orders, but connected bots may.

# Lighter perpetuals — mainnet
# LIGHTER_PERPETUAL_L1_ADDRESS=
# LIGHTER_PERPETUAL_API_KEY_INDEX=
# LIGHTER_PERPETUAL_API_PRIVATE_KEY=
# LIGHTER_PERPETUAL_ACCOUNT_LIMIT=Standard

# Lighter perpetuals — separate testnet account/key
# LIGHTER_PERPETUAL_TESTNET_L1_ADDRESS=
# LIGHTER_PERPETUAL_TESTNET_API_KEY_INDEX=
# LIGHTER_PERPETUAL_TESTNET_API_PRIVATE_KEY=
# LIGHTER_PERPETUAL_TESTNET_ACCOUNT_LIMIT=Standard

# Lighter spot — mainnet
# LIGHTER_L1_ADDRESS=
# LIGHTER_ACCOUNT_INDEX=
# LIGHTER_API_KEY_INDEX=
# LIGHTER_API_PRIVATE_KEY=
# LIGHTER_ACCOUNT_LIMIT=Standard

# Lighter spot — separate testnet account/key
# LIGHTER_TESTNET_L1_ADDRESS=
# LIGHTER_TESTNET_ACCOUNT_INDEX=
# LIGHTER_TESTNET_API_KEY_INDEX=
# LIGHTER_TESTNET_API_PRIVATE_KEY=
# LIGHTER_TESTNET_ACCOUNT_LIMIT=Standard

# Coinbase Advanced Trade — mainnet
# COINBASE_ADVANCED_TRADE_API_KEY=
# COINBASE_ADVANCED_TRADE_API_SECRET=

# Kraken — mainnet (optional API tier remains the connector default)
# KRAKEN_API_KEY=
# KRAKEN_API_SECRET=

# Gemini — mainnet
# GEMINI_API_KEY=
# GEMINI_API_SECRET=

# Bitstamp — mainnet (its separate sandbox is not wired)
# BITSTAMP_API_KEY=
# BITSTAMP_API_SECRET=


# ── Model fallback (optional) ────────────────────────
# When a delegated agent's own model backend is down, the run answers on this
# model instead (default: claude-code). Set it empty to fail the run rather than
# switch provider: wanted for free-only tests, where a silent fallback spends on
# a different account. `uv run python -m condor.agents.seats` shows what is in force.
# AGENT_FALLBACK_MODEL=
